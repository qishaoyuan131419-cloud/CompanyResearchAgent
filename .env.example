# Service
CRA_ENVIRONMENT=development
CRA_LOG_LEVEL=INFO
CRA_API_PREFIX=/v1
# Required in production. Send it as the service authentication credential.
CRA_SERVICE_API_KEY=replace-me
CRA_MAX_CONCURRENT_RUNS=4
CRA_RUN_TIMEOUT_SECONDS=900

# LLM provider: openai or anthropic. Base URL is explicit by design.
CRA_LLM_PROVIDER=openai
CRA_LLM_API_KEY=replace-me
CRA_LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
CRA_LLM_MODEL=replace-me
CRA_LLM_TIMEOUT_SECONDS=60
CRA_LLM_MAX_RETRIES=2
CRA_LLM_MAX_OUTPUT_TOKENS=4096
CRA_LLM_OPENAI_MAX_TOKENS_FIELD=max_completion_tokens
CRA_LLM_TEMPERATURE=0
# Set these to the configured model's current prices; production rejects zero-priced budgets.
CRA_LLM_INPUT_COST_PER_MILLION=1
CRA_LLM_OUTPUT_COST_PER_MILLION=1

# Exa hosted MCP Streamable HTTP endpoint and optional API key.
CRA_EXA_MCP_URL=https://your-exa-mcp-endpoint.example/mcp?tools=web_search_advanced_exa
CRA_EXA_API_KEY=replace-me
CRA_EXA_SEARCH_TOOL=web_search_advanced_exa
CRA_EXA_RESULTS_PER_QUERY=8
CRA_EXA_MAX_TEXT_CHARACTERS=20000
# Optional trusted domain classification, encoded as JSON.
CRA_SOURCE_TYPE_DOMAIN_RULES={"example-pharma.com":"official","trusted-news.example":"news"}

# Workflow and search controls
CRA_MAX_SEARCH_ROUNDS=3
CRA_SEARCH_TIMEOUT_SECONDS=315
CRA_SEARCH_MAX_RETRIES=1
CRA_SEARCH_BACKOFF_BASE_SECONDS=0.5
CRA_SEARCH_MAX_CONCURRENCY=8
CRA_MAX_QUERIES_PER_ROUND=30
CRA_MAX_TOTAL_QUERIES=50
CRA_MAX_CONSECUTIVE_FAILED_ROUNDS=2
CRA_NO_NEW_EVIDENCE_ROUNDS=1
CRA_EVIDENCE_LIMIT=500
CRA_EXTRACTION_BATCH_SIZE=8
CRA_EXTRACTION_MAX_PROMPT_BYTES=80000
CRA_TOKEN_BUDGET=100000
CRA_COST_BUDGET_USD=25
CRA_SUFFICIENT_COVERAGE_THRESHOLD=0.75
CRA_MINIMUM_DIMENSION_COVERAGE=0.40

# Cache
CRA_CACHE_ENABLED=true
CRA_CACHE_PATH=.cache/research-agent.sqlite3
CRA_SEARCH_CACHE_TTL_SECONDS=86400
CRA_PAGE_CACHE_TTL_SECONDS=86400
CRA_LLM_CACHE_TTL_SECONDS=604800
